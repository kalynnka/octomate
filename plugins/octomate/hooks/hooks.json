{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "octomate-emit --path /hooks/codex", "timeout": 10},
          {"type": "command", "command": "octomate-launch --path /hooks/codex --agent codex --octomate octomate", "timeout": 10}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "octomate-emit --path /hooks/codex", "timeout": 10},
          {"type": "command", "command": "octomate-launch --path /hooks/codex --agent codex --octomate octomate", "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "octomate-emit --path /hooks/codex", "timeout": 10}
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {"type": "command", "command": "octomate-emit --path /hooks/codex", "timeout": 10}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {"type": "command", "command": "octomate-emit --path /hooks/codex", "timeout": 10},
          {"type": "command", "command": "octomate-launch --path /hooks/codex --agent codex --octomate octomate", "timeout": 10}
        ]
      }
    ]
  }
}
