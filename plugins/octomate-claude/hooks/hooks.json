{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "octomate-emit --path /hooks/claude", "timeout": 10},
          {"type": "command", "command": "octomate-launch --path /hooks/claude --agent claude --octomate octomate", "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "octomate-emit --path /hooks/claude", "timeout": 10}
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "octomate-emit --path /hooks/claude", "timeout": 10}
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {"type": "command", "command": "octomate-emit --path /hooks/claude", "timeout": 10}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {"type": "command", "command": "octomate-emit --path /hooks/claude", "timeout": 10}
        ]
      }
    ]
  }
}
