{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Octomate",
      "type": "debugpy",
      "request": "launch",
      "module": "octomate_cli.main",
      "args": [
        "service",
        "serve",
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Octomate (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "octomate_cli.main",
      "args": [
        "service",
        "serve",
        "--reload",
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "MkDocs (reload)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "mkdocs",
      "args": ["serve", "--livereload", "--dev-addr", "127.0.0.1:8001"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Trunkline (reload)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}/trunkline"
    },
  ],
  "compounds": [
    {
      "name": "Octomate + Trunkline",
      "configurations": ["Octomate", "Trunkline (reload)"],
      "stopAll": true
    },
  ]
}
