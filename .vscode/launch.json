{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Octomate",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "octomate.app:create_app",
        "--factory",
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Octomate (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "octomate.app:create_app",
        "--factory",
        "--reload",
        "--reload-dir",
        "octomate",
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Trunkline (reload)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}/trunkline"
    },
  ],
  "compounds": [
    {
      "name": "Octomate + Trunkline",
      "configurations": ["Octomate", "Trunkline (reload)"],
      "stopAll": true
    },
  ]
}
