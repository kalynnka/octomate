{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Octomate: debug attachment on",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/debug_attachment.py",
        "on"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "echo": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Octomate: debug attachment off",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/scripts/debug_attachment.py",
        "off"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "echo": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    }
  ]
}
