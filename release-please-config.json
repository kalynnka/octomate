{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "component": "octomate",
      "exclude-paths": [
        "cli",
        "protocol",
        "tests",
        "docs",
        "trunkline",
        ".github",
        ".vscode",
        "mkdocs.yml",
        "AGENTS.md",
        "claude.md"
      ]
    },
    "cli": {
      "component": "octomate-cli"
    },
    "protocol": {
      "component": "octomate-protocol"
    }
  }
}
